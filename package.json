{
    "name": "salesforce-data-migrator",
    "version": "0.0.1",
    "description": "Salesforce data migration and sync tool with admin UI",
    "main": "src/server.js",
    "author": {
        "name": "Anand Pilania",
        "email": "pilaniaanand@gmail.com"
    },
    "scripts": {
        "start": "set NODE_ENV=production&& node src/server/server.js",
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "dev:server": "set NODE_ENV=development&& nodemon src/server/server.js",
        "dev:client": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "serve": "set NODE_ENV=production&& node src/server/server.js"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "cronstrue": "^3.2.0",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "jsforce": "^3.0.0",
        "jsonwebtoken": "^9.0.2",
        "lucide-react": "^0.525.0",
        "mongodb": "^6.3.0",
        "node-cron": "^3.0.3",
        "pg": "^8.11.3",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "uuid": "^9.0.1",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.2.0",
        "concurrently": "^9.2.0",
        "nodemon": "^3.0.2",
        "vite": "^5.0.0"
    }
}
